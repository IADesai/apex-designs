---
import { Image } from 'astro:assets';
import logo from '../assets/logo/apex-logo.png';
const links = [
  { href: '/services/', label: 'Services' },
  { href: '/work/', label: 'Portfolio' },
  { href: '/learn/', label: 'Learn' },
  { href: '/about/', label: 'About' },
];
const path = Astro.url.pathname;
---
<header class="site-header" data-header>
  <div class="container bar">
    <a class="brand" href="/" aria-label="Apex Designs home">
      <Image src={logo} alt="Apex Designs" width={84} height={84} densities={[1, 2]} loading="eager" />
    </a>
    <button class="menu-toggle" aria-expanded="false" aria-controls="site-nav" data-menu-toggle>
      <span class="visually-hidden">Menu</span><span class="bars" aria-hidden="true"></span>
    </button>
    <nav id="site-nav" class="nav" aria-label="Main">
      {links.map((l) => (
        <a href={l.href} aria-current={path.startsWith(l.href) ? 'page' : undefined}>{l.label}</a>
      ))}
      <a class="btn btn-primary btn-sm" href="/quote/" data-track="nav-quote" data-magnetic>Get a quote</a>
    </nav>
  </div>
</header>

<style>
  .site-header { position: fixed; inset: 0 0 auto; z-index: 50; transition: background 0.35s, box-shadow 0.35s; }
  .site-header.is-scrolled { background: rgb(255 255 242 / 0.94); backdrop-filter: blur(10px); box-shadow: 0 6px 24px -18px rgb(83 74 69 / 0.6); }
  .bar { display: flex; align-items: center; justify-content: space-between; height: 100px; transition: height 0.35s; }
  .is-scrolled .bar { height: 76px; }
  .brand { display: block; }
  .brand :global(img) { width: 84px; height: 84px; transition: width 0.35s, height 0.35s; }
  .is-scrolled .brand :global(img) { width: 62px; height: 62px; }
  .nav { display: flex; align-items: center; gap: clamp(18px, 3vw, 40px); }
  .nav a:not(.btn) { text-decoration: none; text-transform: uppercase; font-size: 0.92rem; letter-spacing: 0.04em; color: #2c2927; transition: color 0.2s; }
  .nav a:not(.btn):hover, .nav a[aria-current='page'] { color: var(--teal); }
  .btn-sm { padding: 0.8em 1.3em; font-size: 0.92rem; }
  .menu-toggle { display: none; background: none; border: 0; width: 44px; height: 44px; cursor: pointer; }
  .bars, .bars::before, .bars::after { display: block; width: 24px; height: 2px; background: var(--heading); position: relative; transition: transform 0.3s; }
  .bars::before, .bars::after { content: ''; position: absolute; left: 0; }
  .bars::before { top: -7px; }
  .bars::after { top: 7px; }
  .menu-toggle[aria-expanded='true'] .bars { background: transparent; }
  .menu-toggle[aria-expanded='true'] .bars::before { transform: translateY(7px) rotate(45deg); }
  .menu-toggle[aria-expanded='true'] .bars::after { transform: translateY(-7px) rotate(-45deg); }
  @media (max-width: 820px) {
    .bar { height: 80px; }
    .brand :global(img) { width: 64px; height: 64px; }
    .menu-toggle { display: block; }
    .nav { position: fixed; inset: 80px 0 auto; flex-direction: column; align-items: stretch; gap: 0; padding: 8px var(--gutter) 24px; background: var(--bg); box-shadow: 0 16px 30px -20px rgb(83 74 69 / 0.6); transform: translateY(-130%); visibility: hidden; transition: transform 0.35s var(--ease), visibility 0.35s; }
    .is-scrolled .nav { inset: 76px 0 auto; }
    .nav.is-open { transform: none; visibility: visible; }
    .nav a:not(.btn) { padding: 14px 0; border-bottom: 1px solid var(--line); font-size: 1rem; }
    .nav .btn { margin-top: 16px; }
  }
</style>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]');
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const nav = document.getElementById('site-nav');
  const onScroll = () => header?.classList.toggle('is-scrolled', window.scrollY > 24);
  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();
  toggle?.addEventListener('click', () => {
    const open = toggle.getAttribute('aria-expanded') !== 'true';
    toggle.setAttribute('aria-expanded', String(open));
    nav?.classList.toggle('is-open', open);
  });
</script>
