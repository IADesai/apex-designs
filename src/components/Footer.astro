---
import { Image } from 'astro:assets';
import logo from '../assets/logo/apex-logo.png';
import { site } from '../config/site';
import { whatsappUrl, DEFAULT_WA_TEXT } from '../lib/whatsapp';
const year = new Date().getFullYear();
const areas = [
  { href: '/web-design-romford/', label: 'Web design Romford' },
  { href: '/web-design-east-london/', label: 'Web design East London' },
  { href: '/web-design-essex/', label: 'Web design Essex' },
  { href: '/remote-web-design-uk/', label: 'Remote web design UK' },
];
---
<footer class="site-footer">
  <div class="container cols">
    <div class="brandcol">
      <a href="/" aria-label="Apex Designs home"><Image src={logo} alt="Apex Designs" width={200} height={200} densities={[1, 2]} /></a>
      <p class="muted">Websites that click. A one-person web studio in Romford, building for businesses across East London, Essex and the UK.</p>
    </div>
    <nav aria-label="Areas">
      <p class="fh">Areas</p>
      <ul>{areas.map((a) => <li><a href={a.href}>{a.label}</a></li>)}</ul>
    </nav>
    <nav aria-label="Site">
      <p class="fh">Explore</p>
      <ul>
        <li><a href="/services/">Packages &amp; prices</a></li>
        <li><a href="/work/">Portfolio</a></li>
        <li><a href="/learn/">Learn</a></li>
        <li><a href="/about/">About</a></li>
        <li><a href="/quote/">Get a quote</a></li>
      </ul>
    </nav>
    <div>
      <p class="fh">Talk to Ibrahim</p>
      <ul>
        <li><a href={`mailto:${site.email}`}>{site.email}</a></li>
        <li><a href={whatsappUrl(site.whatsapp, DEFAULT_WA_TEXT)} data-wa rel="noopener" target="_blank">WhatsApp</a></li>
      </ul>
    </div>
  </div>
  <div class="legal">
    <div class="container legal-inner">
      <span>Copyright © {year} Apex Designs · Romford, Greater London</span>
      <span class="links">
        <a href="/cookies/">Cookie Policy (UK)</a><a href="/privacy/">Privacy Policy</a><a href="/terms/">Terms and Conditions</a>
        <button type="button" class="linklike" data-consent-open>Cookie settings</button>
      </span>
    </div>
  </div>
</footer>

<style>
  .site-footer { background: #fff; border-top: 1px solid var(--line); padding-top: 64px; }
  .cols { display: grid; gap: 40px; grid-template-columns: 1.6fr repeat(3, 1fr); align-items: start; }
  @media (max-width: 900px) { .cols { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 560px) { .cols { grid-template-columns: 1fr; } }
  .brandcol :global(img) { width: 200px; height: 200px; margin: -16px 0 8px -12px; }
  .brandcol p { max-width: 34ch; }
  .fh { font: 600 0.78rem/1 var(--font-body); letter-spacing: 0.14em; text-transform: uppercase; color: var(--accent); margin-bottom: 1rem; }
  ul { list-style: none; padding: 0; margin: 0; display: grid; gap: 0.55rem; }
  ul a { color: var(--text); text-decoration: none; }
  ul a:hover { color: var(--teal); }
  .legal { margin-top: 48px; border-top: 1px solid var(--line); padding-block: 22px; font-size: 0.86rem; color: var(--text-dim); }
  .legal-inner { display: flex; flex-wrap: wrap; gap: 10px 24px; justify-content: space-between; }
  .links { display: flex; flex-wrap: wrap; gap: 16px; }
  .links a { color: inherit; }
  .linklike { background: none; border: 0; padding: 0; color: inherit; font: inherit; text-decoration: underline; cursor: pointer; }
</style>
