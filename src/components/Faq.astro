---
import type { Faq } from '../data/faqs';
interface Props { items: Faq[] }
const { items } = Astro.props;
---
<div class="faq">
  {items.map((f) => (
    <details class="card">
      <summary><h3>{f.q}</h3></summary>
      <p class="muted">{f.a}</p>
    </details>
  ))}
</div>
<style>
  .faq { display: grid; gap: 12px; }
  details { padding: 0; }
  summary { cursor: pointer; list-style: none; padding: 22px 56px 22px 24px; position: relative; }
  summary::-webkit-details-marker { display: none; }
  summary::after { content: '+'; position: absolute; right: 24px; top: 50%; transform: translateY(-50%); font-size: 1.6rem; color: var(--accent); transition: transform 0.3s; }
  details[open] summary::after { transform: translateY(-50%) rotate(45deg); }
  summary h3 { margin: 0; font-size: 1.15rem; }
  details p { padding: 0 24px 22px; margin: 0; }
</style>
