---
import { Image } from 'astro:assets';
import logo from '../assets/logo/apex-logo.png';
---
<section class="hero" data-hero="fallback" aria-labelledby="hero-title">
  <div class="container grid">
    <div class="copy">
      <span class="eyebrow">Romford · East London · Essex · UK-wide</span>
      <h1 id="hero-title">Websites that <span class="accent">click.</span><span class="sub">Web design in Romford &amp; East London</span></h1>
      <p class="lead">I'm Ibrahim, a one-person web studio building fast, custom websites for local businesses. Clear prices from £300, and you deal with me from the first call to launch day.</p>
      <div class="ctas">
        <a class="btn btn-primary btn-display" href="/services/" data-track="hero-packages" data-magnetic>View services</a>
        <a class="btn btn-ghost" href="/quote/" data-track="hero-quote">Get a free quote</a>
      </div>
      <p class="proof"><span aria-hidden="true">★★★★★</span> Rated <strong>Excellent</strong> on Google · 5 reviews</p>
    </div>
    <div class="visual" aria-hidden="true">
      <Image class="fallback" src={logo} alt="" widths={[320, 520, 760]} sizes="(max-width: 900px) 70vw, 520px" loading="eager" />
      <canvas data-hero-canvas></canvas>
    </div>
  </div>
</section>

<style>
  .hero { position: relative; padding: clamp(120px, 14vw, 170px) 0 clamp(40px, 6vw, 80px); overflow: hidden; }
  .hero::before { content: ''; position: absolute; inset: auto -10% -30% 40%; height: 70%; background: radial-gradient(closest-side, rgb(62 125 110 / 0.1), transparent); pointer-events: none; }
  .grid { position: relative; display: grid; grid-template-columns: 1.05fr 1fr; gap: clamp(24px, 4vw, 64px); align-items: center; min-height: min(78svh, 760px); }
  .copy { position: relative; z-index: 1; }
  h1 { max-width: 12ch; }
  .sub { display: block; margin-top: 0.55em; font: 500 clamp(1rem, 1.5vw, 1.2rem)/1.3 var(--font-body); letter-spacing: 0.01em; color: var(--text-dim); }
  .ctas { display: flex; flex-wrap: wrap; gap: 12px; margin: 30px 0 22px; }
  .proof { font-size: 0.92rem; color: var(--text-dim); }
  .proof span { color: #f5b301; letter-spacing: 2px; margin-right: 6px; }
  .visual { position: relative; aspect-ratio: 1 / 0.95; width: 100%; }
  .visual canvas, .visual :global(.fallback) { position: absolute; inset: 0; width: 100%; height: 100%; }
  .visual :global(.fallback) { object-fit: contain; padding: 6%; transition: opacity 0.8s; }
  canvas { opacity: 0; transition: opacity 1s var(--ease); }
  .hero[data-hero='live'] canvas { opacity: 1; }
  .hero[data-hero='live'] .visual :global(.fallback) { opacity: 0; }
  @media (max-width: 900px) {
    .grid { grid-template-columns: 1fr; min-height: 0; }
    .visual { order: -1; max-width: 460px; margin: -20px auto 0; aspect-ratio: 1 / 0.8; }
  }
</style>

<script>
  import { readRenderEnv, shouldRender3D } from '../scripts/hero/capability';
  const root = document.querySelector<HTMLElement>('[data-hero]');
  if (root && shouldRender3D(readRenderEnv(window))) {
    import('../scripts/hero/scene')
      .then(({ initHero }) => initHero(root))
      .catch(() => { root.dataset.hero = 'fallback'; });
  }
</script>
