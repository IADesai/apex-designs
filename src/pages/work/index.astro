---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import WorkCard from '../../components/WorkCard.astro';
import CtaBand from '../../components/CtaBand.astro';
import { breadcrumbJsonLd } from '../../lib/seo';
const work = (await getCollection('work')).sort((a, b) => a.data.order - b.data.order);
---
<BaseLayout
  title="Web Design Portfolio"
  description="Websites built by Apex Designs for charities, restaurants, venues, sales funnels and professional services across London, Oxford and the UK."
  jsonLd={[breadcrumbJsonLd([{ name: 'Home', path: '/' }, { name: 'Work', path: '/work/' }])]}
>
  <PageHero eyebrow="Work" lead="Real sites for real businesses and charities, each one designed around the people it serves.">Web design portfolio</PageHero>
  <section class="container tight">
    <div class="grid-2" data-reveal-stagger>{work.map((entry, i) => <WorkCard entry={entry} featured={i === 0} />)}</div>
  </section>
  <CtaBand heading="Want yours here next?" />
</BaseLayout>
<style>.tight { padding-bottom: 40px; }</style>
